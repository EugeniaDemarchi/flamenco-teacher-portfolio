# Copiá este archivo como .env y completá los valores. El .env NUNCA se sube a Git.
# En producción, los valores se cargan en Netlify: Site configuration → Environment variables.

# Base de datos (MongoDB Atlas, cuenta de Natalia · NR-17)
MONGODB_URI=

# Sesión: secreto para firmar el JWT. Mínimo 32 caracteres aleatorios (especificación, 11.2)
JWT_SECRETO=

# Secreto para cifrar las IP en el límite de intentos (especificación, 10.2 y 11.2)
IP_HASH_SECRETO=

# Imágenes (Cloudinary, cuenta de Natalia · NR-17)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Envío de mails (Resend o Brevo, a definir)
EMAIL_API_KEY=
EMAIL_REMITENTE=
# Adónde llegan los avisos de Contacto (mail de Natalia)
CONTACTO_DESTINO=

# URL pública del sitio, para armar el enlace de recuperación de contraseña
URL_SITIO=http://localhost:8888